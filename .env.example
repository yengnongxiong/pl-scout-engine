# Copy to .env and adjust. All variables are optional.
# SCOUT_CONFIG_DIR=config
# SCOUT_DATA_DIR=data
# SCOUT_DATABASE_URL=sqlite:///data/warehouse/scout.db
# Optional Postgres (docker compose up -d db):
# SCOUT_DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout
# SCOUT_LOG_LEVEL=INFO
# Report engine: template (default) or ollama (optional local LLM; never required)
REPORT_ENGINE=template
# SCOUT_OLLAMA_MODEL=llama3.1:8b
